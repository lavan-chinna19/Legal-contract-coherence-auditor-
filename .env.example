# .env.example — Legal Contract Coherence Auditor Environment Configuration
# DO NOT COMMIT REAL SECRETS. Copy to .env for local deployment.

# ── API Authentication ──
# Secret key used for authenticating API requests (X-API-Key or Bearer token)
API_KEY=dev_auditor_key_12345
API_KEYS=dev_auditor_key_12345,secondary_key_abc

# ── Encryption at Rest (Fernet AES-128-CBC + HMAC-SHA256) ──
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, an ephemeral key is generated per process (development only).
STORAGE_ENCRYPTION_KEY=

# ── Data Retention Policy ──
# Time-to-live for uploaded encrypted documents in seconds (default: 86400 = 24 hours)
RETENTION_TTL_SECONDS=86400

# ── Database (PostgreSQL) ──
POSTGRES_DB=legal_auditor
POSTGRES_USER=auditor_user
POSTGRES_PASSWORD=auditor_secure_pass
DATABASE_URL=postgresql://auditor_user:auditor_secure_pass@localhost:5432/legal_auditor

# ── Object Storage (MinIO locally / Cloudflare R2 in cloud) ──
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=contract-uploads
S3_REGION=auto

# ── Frontend Configuration ──
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
