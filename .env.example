# .env.example — Legal Contract Coherence Auditor Environment Configuration
# DO NOT COMMIT REAL SECRETS. Copy to .env and generate private values locally.
# For synthetic demonstrations use scripts/run_server.py --demo instead.

# ── API Authentication ──
# Secret key used for authenticating API requests (X-API-Key or Bearer token)
API_KEY=
API_KEYS=
# Administrative key used for administrative actions (e.g. POST /v1/maintenance/cleanup)
ADMIN_API_KEY=

# ── Encryption at Rest (Fernet AES-128-CBC + HMAC-SHA256) ──
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, an ephemeral key is generated per process (development only).
STORAGE_ENCRYPTION_KEY=

# ── Data Retention Policy ──
# Time-to-live for uploaded encrypted documents in seconds (default: 86400 = 24 hours)
RETENTION_TTL_SECONDS=86400

# ── Database (PostgreSQL) ──
POSTGRES_DB=legal_auditor
POSTGRES_USER=auditor_user
POSTGRES_PASSWORD=
# Leave blank for local SQLite, or supply a private PostgreSQL connection URL.
DATABASE_URL=

# ── Object Storage (MinIO locally / Cloudflare R2 in cloud) ──
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=contract-uploads
S3_REGION=auto

# ── Frontend Configuration ──
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Browser origin allowlist; comma separated. Keep API keys out of NEXT_PUBLIC_*.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
# Optional separate upload directory for synthetic testing.
# LEXAUDIT_UPLOAD_DIR=data/release-demo-uploads
# Models load from local cache by default. Enable only for initial model download.
LEXAUDIT_ALLOW_MODEL_DOWNLOAD=0
